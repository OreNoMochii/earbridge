{
  // Server, shared code, all tests and the Vite config. Node runs these .ts files directly
  // (type stripping), so only erasable TypeScript syntax is allowed: no enums, namespaces
  // or parameter properties.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["server", "shared", "client/test", "vite.config.ts"]
}
