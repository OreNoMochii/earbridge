# Copy to .env and fill in. Keys stay on the server; the browser never sees them.

# Required: speech-to-text. Get a key at https://console.deepgram.com
DEEPGRAM_API_KEY=

# Claude translation. Get a key at https://platform.claude.com
# (Optional if you have logged in with `ant auth login`; the SDK picks that up.)
ANTHROPIC_API_KEY=

# Optional tuning (defaults shown)
# TRANSLATION_MODEL=claude-opus-5
# TRANSLATION_EFFORT=low          # low | medium | high | xhigh | max  (lower = faster)
# DEEPGRAM_MODEL=nova-3           # falls back to nova-2 automatically if a language is not supported
# PORT=8787
# DEEPGRAM_URL=wss://api.deepgram.com/v1/listen   # e.g. a regional or self-hosted endpoint

# Optional: require this shared secret before anyone can use your server (strongly
# recommended when deployed publicly, otherwise anyone can spend your API credits).
# ACCESS_TOKEN=

# Optional: serve HTTPS directly (phones only allow the microphone on https:// pages).
# TLS_CERT=/path/to/cert.pem
# TLS_KEY=/path/to/key.pem

# Optional: extra page origins allowed to open the WebSocket, comma-separated. Only needed
# behind a proxy that changes the Host header; by default the page must come from the
# same host as the server.
# ALLOWED_ORIGINS=https://translate.example.com
